# Copy to deploy/space.env (git-ignored) and fill in. push_db.py reads DATABASE_URL from here;
# paste the same values into Render's environment settings.
# Supabase -> Connect -> Session pooler (IPv4) URI, with your database password and ?sslmode=require
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# A NEW Groq key (the old one was shared in chat)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
